# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# ─── Base de datos (Supabase) ───────────────────────────────────────────────
# Supabase → botón "Connect" (o Project Settings → Database) → Connection string.
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base. Si tiene caracteres especiales, codifícalos (@ → %40).
#
# DATABASE_URL: TRANSACTION POOLER (Supavisor, puerto 6543) con ?pgbouncer=true.
#   La usa la API en tiempo de ejecución: muchas conexiones cortas, compartidas.
#   Ejemplo: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
#
# DIRECT_URL: CONEXIÓN DIRECTA (db.<project-ref>.supabase.co:5432) o SESSION POOLER (puerto 5432).
#   La usan las migraciones (npm run db:migrate) y la CLI de Prisma: necesitan una sesión completa,
#   que el transaction pooler no da. La conexión directa solo funciona con IPv6; si tu red no tiene IPv6,
#   usa el session pooler.
#   Directa:        postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   Session pooler: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ─── Servidor ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Orígenes del front que pueden llamar a la API (CORS), separados por coma.
# Si no se define, se usa http://localhost:5173 (Vite). Ejemplo: http://localhost:5173,https://capaz.ejemplo.ec
CORS_ORIGINS=http://localhost:5173
# URL pública del front: arma el enlace del QR "Continuar en el celular"
PUBLIC_WEB_URL=http://localhost:5173

# ─── Seguridad ──────────────────────────────────────────────────────────────
# Clave AES-256 para cifrar las fotos del carnet y la hoja de vida. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde o se cambia, lo ya guardado no se puede leer.
ID_CARD_ENCRYPTION_KEY=
# Token del admin de demostración (mínimo 12 caracteres). Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
SESSION_TTL_DAYS=30
PRIVACY_POLICY_VERSION=2026-11-draft

# ─── Servicios externos (por ahora solo "mock") ─────────────────────────────
OCR_PROVIDER=mock
MESSAGING_PROVIDER=mock
TRANSCRIBE_PROVIDER=mock
TTS_PROVIDER=mock
# Solo desarrollo: devuelve los códigos de 4 dígitos (ingreso y verificación del celular)
# en la respuesta como devCode. La API no arranca si está activo con NODE_ENV=production.
EXPOSE_DEV_LOGIN_CODE=true
